# ---------------------------------------------------------------------------
# Cloud Panda — Frontend environment
# Copy this file to `.env.local` and adjust. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Contract release this build is written against — workflow § 9.
# The frontend pins ONE release and consumes its artifacts (openapi.yaml +
# generated client + SHA256SUMS). It must never track `main` or keep a second
# copy of the contract. Quote this value on any integration defect ticket.
NEXT_PUBLIC_CONTRACT_VERSION=contract-v0.0.0-prefreeze

# Base URL of the backend REST API. No trailing slash.
# MUST end with /api/v1 — the Vercel HTTP Gateway is the only public boundary
# (workflow § 1.1). The frontend never calls Convex directly.
# The frontend NEVER hard-codes an API URL — every request goes through
# `src/services/http.ts`, which reads this value.
#
# NOTE: this project uses Next.js, so the variable is prefixed NEXT_PUBLIC_
# (Next has no `import.meta.env`, so a `VITE_` prefix would not be readable).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Which data source the API layer resolves to.
#   mock  -> src/services/mock/*  (no backend needed, runs standalone)
#   http  -> src/services/http-impl/*  (talks to NEXT_PUBLIC_API_BASE_URL)
# Switching this value is the ONLY change needed to move from mock to a real
# backend. No UI or business-logic file references either implementation.
NEXT_PUBLIC_API_ADAPTER=mock

# Artificial latency (ms) applied by the mock adapter so loading states are
# actually visible during development. Ignored when adapter is `http`.
NEXT_PUBLIC_MOCK_LATENCY=450

# Request timeout in milliseconds.
NEXT_PUBLIC_API_TIMEOUT=15000
