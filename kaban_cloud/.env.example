# Environment variables for kaban_cloud
#
# The demo web app (src/App.tsx -> DealBoard / SalesPipelineBoard) runs
# entirely on in-memory DataAdapters (see src/examples/*/config.ts) and
# currently reads NO environment variables. You do not need to set anything
# in Vercel for the default deployment to work.
#
# The variables below are placeholders only, for when you wire one of the
# boards to a real backend using the library's existing adapters
# (src/adapters/supabase.ts, src/adapters/fetch-api.ts). Vite only exposes
# variables prefixed with VITE_ to client code (import.meta.env.VITE_*).
#
# If you do wire up Supabase, create the client yourself (e.g. in a new
# src/lib/supabaseClient.ts) using these variables, then pass it into
# createSupabaseAdapter({ client, ... }) — the library never reads env vars
# directly, so no code changes are required here to keep this file accurate.

# Supabase project URL (Project Settings -> API)
VITE_SUPABASE_URL=

# Supabase anon/public API key (safe for client-side use)
VITE_SUPABASE_ANON_KEY=
