{
  "name": "@kanban/library",
  "version": "1.0.0",
  "description": "Reusable, headless-friendly Kanban board library for React — extend it for Sales Pipeline, Task Management, Roadmap, HR, and more.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist-lib"
  ],
  "main": "./dist-lib/kanban-library.cjs.js",
  "module": "./dist-lib/kanban-library.es.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/kanban-library.es.js",
      "require": "./dist-lib/kanban-library.cjs.js"
    },
    "./styles.css": "./dist-lib/kanban-library.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:lib": "tsc -p tsconfig.json --noEmit && vite build --config vite.lib.config.ts && npm run build:css",
    "build:css": "tailwindcss -i src/styles.css -o dist-lib/kanban-library.css --minify",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^0.400.0"
  },
  "optionalDependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.39",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^2.1.9"
  }
}
